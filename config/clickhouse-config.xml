<clickhouse>
    <!-- Agency OS keeps two tiny analytical tables. Disable ClickHouse's own
         high-volume diagnostic logs; useful operational state lives in Postgres
         and alerts are emitted on state changes. -->
    <query_log remove="1"/>
    <query_metric_log remove="1"/>
    <trace_log remove="1"/>
    <query_thread_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <error_log remove="1"/>
    <crash_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
    <max_concurrent_queries>4</max_concurrent_queries>
    <listen_host>0.0.0.0</listen_host>
</clickhouse>
