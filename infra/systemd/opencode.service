[Unit]
Description=OpenCode Web - Agency OS Brain
After=network.target docker.service
Wants=docker.service

[Service]
EnvironmentFile=/etc/agency/opencode.env
Type=simple
User=agency
Group=agency
WorkingDirectory=/home/agency/projects
ExecStart=/home/agency/.opencode/bin/opencode web --hostname 100.64.0.1 --port 4096
Restart=on-failure
RestartSec=10
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
