# /etc/systemd/system/agency-bot.service
[Unit]
Description=Agency OS Discord steering bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agency
WorkingDirectory=/home/agency/agency-os/bot
ExecStart=/home/agency/agency-os/bot/.venv/bin/python /home/agency/agency-os/bot/agency_bot.py
EnvironmentFile=/home/agency/agency-os/bot/.env
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
