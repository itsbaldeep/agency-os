[Unit]
Description=Caddy on-demand TLS allow-list
After=network.target

[Service]
EnvironmentFile=/etc/agency/opencode.env
Type=simple
User=agency
WorkingDirectory=/home/agency/agency-os
ExecStart=/usr/bin/python3 /home/agency/agency-os/caddy-ask.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
