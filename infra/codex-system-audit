#!/bin/bash
set -euo pipefail

ROOT_BACKUP_DIR="/var/backups/agency-os"
temporary_backup=""

cleanup_backup() {
  if [ -n "$temporary_backup" ]; then
    rm -f -- "$temporary_backup"
  fi
}
trap cleanup_backup EXIT

backup_core() {
  local timestamp final_backup
  local -a paths=(
    etc/systemd/system
    usr/lib/systemd/system/headscale.service
    usr/lib/systemd/system/caddy.service
    etc/ufw
    etc/default/ufw
    etc/sudoers
    etc/sudoers.d
    etc/headscale
    var/lib/headscale
    etc/caddy
    var/lib/caddy
  )

  umask 077
  if [ -e "$ROOT_BACKUP_DIR" ] || [ -L "$ROOT_BACKUP_DIR" ]; then
    if [ ! -d "$ROOT_BACKUP_DIR" ] || [ -L "$ROOT_BACKUP_DIR" ] \
      || [ "$(realpath -e "$ROOT_BACKUP_DIR")" != "$ROOT_BACKUP_DIR" ]; then
      echo "Refusing unsafe backup directory" >&2
      return 1
    fi
  fi
  install -d -o root -g agency -m 0750 "$ROOT_BACKUP_DIR"

  for path in "${paths[@]}"; do
    if [ ! -e "/$path" ]; then
      echo "Required recovery source is missing: /$path" >&2
      return 1
    fi
  done

  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  final_backup="$ROOT_BACKUP_DIR/core-system-$timestamp.tar.gz"
  if [ -e "$final_backup" ]; then
    echo "Backup target already exists" >&2
    return 1
  fi

  temporary_backup="$(mktemp "$ROOT_BACKUP_DIR/.core-system.XXXXXX.tar.gz")"
  tar --create --gzip --file "$temporary_backup" --directory / --numeric-owner -- "${paths[@]}"
  tar --list --gzip --file "$temporary_backup" >/dev/null
  chown agency:agency "$temporary_backup"
  chmod 0600 "$temporary_backup"
  ln "$temporary_backup" "$final_backup"
  rm -f -- "$temporary_backup"
  temporary_backup=""
  printf '%s\n' "$final_backup"
}

maintenance_begin() {
  systemctl stop cron.service agency-worker.service agency-bot.service caddy-ask.service
}

maintenance_resume() {
  systemctl start caddy-ask.service agency-bot.service agency-worker.service cron.service
  systemctl is-active --quiet caddy-ask.service agency-bot.service agency-worker.service cron.service
}

remove_legacy_opencode_db_secret() {
  local target="/etc/agency/opencode.env"
  local temporary
  if [ ! -f "$target" ]; then
    return 0
  fi
  temporary="$(mktemp /etc/agency/.opencode.env.XXXXXX)"
  if ! awk -F= '$1 != "POSTGRES_PASSWORD"' "$target" >"$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  mv -f -- "$temporary" "$target"
}

tighten_sudoers() {
  local target temporary mode owner group
  local -a policy_files=(/etc/sudoers /etc/sudoers.d/*)
  for target in "${policy_files[@]}"; do
    [ -f "$target" ] || continue
    [ -L "$target" ] && continue
    if ! grep -Eq '^[[:space:]]*agency[[:space:]]+ALL=\(root\)[[:space:]]+NOPASSWD:[[:space:]]*/usr/local/sbin/codex-system-audit[[:space:]]+\*[[:space:]]*$' "$target"; then
      continue
    fi
    temporary="$(mktemp "$(dirname "$target")/.sudoers.XXXXXX")"
    if ! awk '!($0 ~ /^[[:space:]]*agency[[:space:]]+ALL=\(root\)[[:space:]]+NOPASSWD:[[:space:]]*\/usr\/local\/sbin\/codex-system-audit[[:space:]]+\*[[:space:]]*$/)' "$target" >"$temporary"; then
      rm -f -- "$temporary"
      return 1
    fi
    owner="$(stat -c '%U' "$target")"
    group="$(stat -c '%G' "$target")"
    mode="$(stat -c '%a' "$target")"
    chown "$owner:$group" "$temporary"
    chmod "$mode" "$temporary"
    if ! visudo -cf "$temporary" >/dev/null 2>&1; then
      rm -f -- "$temporary"
      return 1
    fi
    mv -f -- "$temporary" "$target"
  done
  visudo -cf /etc/sudoers >/dev/null 2>&1
}

case "${1:-}" in
  cron-users)
    for f in /var/spool/cron/crontabs/*; do
      [ -f "$f" ] || continue
      u="$(basename "$f")"
      echo "USER:$u"
      crontab -u "$u" -l 2>/dev/null \
        | sed -E 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1=[REDACTED]/'
    done
    ;;

  cron-system)
    for f in /etc/crontab /etc/cron.d/*; do
      [ -f "$f" ] || continue
      echo "FILE:$f"
      sed -E 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1=[REDACTED]/' "$f"
    done
    ;;

  sudoers)
    grep -RhvE '^[[:space:]]*(#|$)' /etc/sudoers /etc/sudoers.d 2>/dev/null
    ;;

  sockets)
    ss -lntupH
    ;;

  firewall)
    ufw status verbose
    ;;

  backup-core)
    backup_core
    ;;

  maintenance-begin)
    maintenance_begin
    ;;

  maintenance-resume)
    maintenance_resume
    ;;

  remove-legacy-opencode-db-secret)
    remove_legacy_opencode_db_secret
    ;;

  tighten-sudoers)
    tighten_sudoers
    ;;

  *)
    echo "Usage: $0 {cron-users|cron-system|sudoers|sockets|firewall|backup-core|maintenance-begin|maintenance-resume|remove-legacy-opencode-db-secret|tighten-sudoers}" >&2
    exit 2
    ;;
esac
